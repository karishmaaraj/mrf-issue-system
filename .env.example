# SMTP Email Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Admin Notification Recipient Email
ADMIN_EMAIL=your_admin_notification_email@gmail.com

# Local Server Port
PORT=5000

# Optional: EmailJS Client-Side Configuration
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY

# Meta WhatsApp Cloud API Configuration
WHATSAPP_ENABLED=true
WHATSAPP_TOKEN=YOUR_WHATSAPP_CLOUD_API_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID
WHATSAPP_VERIFY_TOKEN=mrf_whatsapp_verify_token_2026
WHATSAPP_APP_SECRET=YOUR_WHATSAPP_APP_SECRET

# Admin WhatsApp Notification Configuration
# Phone number that receives Admin WhatsApp alerts (E.164 or local format)
ADMIN_WHATSAPP_PHONE=+91XXXXXXXXXX
# Public base URL for Admin Portal deep-links (no trailing slash)
ADMIN_PORTAL_BASE_URL=https://your-ngrok-host.ngrok-free.dev

# Optional Grounded AI Voice Synthesizer Configuration (Phase 3.4)
LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-1.5-flash
LLM_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_TIMEOUT_MS=2000

# Telephony Provider & Voice Webhook Configuration (Phase 5.2)
TELEPHONY_PROVIDER=generic
VOICE_WEBHOOK_SECRET=mrf_voice_secret_2026
VOICE_SIMULATOR_KEY=mrf_voice_sim_key_2026

# Real Speech-To-Text (STT) Configuration (Phase 5.3)
STT_PROVIDER=sarvam
STT_API_KEY=YOUR_SARVAM_OR_GOOGLE_STT_API_KEY_HERE
STT_TIMEOUT_MS=3000
STT_LANGUAGE=ta-IN
STT_MODEL=saaras:v3

# Real Text-To-Speech (TTS) Configuration (Phase 5.4)
TTS_PROVIDER=sarvam
TTS_API_KEY=YOUR_SARVAM_OR_AZURE_TTS_API_KEY_HERE
TTS_TIMEOUT_MS=3000
TTS_LANGUAGE=ta-IN
TTS_VOICE=bulbul:v1
TTS_SAMPLE_RATE=16000

# Voice Audio Media Delivery Configuration (Phase 5.5)
VOICE_MEDIA_TTL_MS=300000
VOICE_MEDIA_MAX_ITEMS=100
VOICE_MEDIA_SECRET=mrf_voice_secret_2026
