# ==============================================================================
# MRF Issue Management System — Environment Configuration Template
# ==============================================================================

# ─── SMTP Email Server Configuration (Used by server.js / Nodemailer) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ─── Admin Notification Recipient Email ───────────────────────────────────────
ADMIN_EMAIL=admin.mrf@gmail.com

# ─── Local Server Port & Host Binding ──────────────────────────────────────────
PORT=5000
HOST=0.0.0.0

# ─── Worker Completion URL Configuration (Localhost vs LAN Testing) ──────────
# LOCALHOST MODE (Default):
# WORKER_COMPLETION_BASE_URL=http://localhost:5000
#
# LAN TESTING MODE (When clicking [COMPLETED] from mobile / other devices on Wi-Fi):
# Set this to your host computer's local IPv4 address (e.g., from ipconfig):
# WORKER_COMPLETION_BASE_URL=http://192.168.x.x:5000
WORKER_COMPLETION_BASE_URL=http://localhost:5000

# ─── Maintenance Worker Email Addresses (Customizable) ────────────────────────
VITE_WORKER_RAJAN_EMAIL=rajan.electrical@mrf.edu
VITE_WORKER_SURESH_EMAIL=suresh.plumbing@mrf.edu
VITE_WORKER_PRIYA_EMAIL=priya.it@mrf.edu
VITE_WORKER_ANITHA_EMAIL=anitha.civil@mrf.edu
VITE_WORKER_BIJU_EMAIL=biju.sanitation@mrf.edu

# ─── Optional: EmailJS Client-Side Configuration (Vite) ───────────────────────
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
